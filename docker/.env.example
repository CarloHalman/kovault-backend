# cp .env.example .env   — read by docker compose in this folder.

# Which host interface the published ports bind to. Default (and the value shipped here) is
# loopback: the stack is reachable from THIS machine only.
#
#   127.0.0.1   this machine only                     — the safe default
#   10.0.0.5    one specific interface, e.g. a LAN or VPN address (recommended if you need
#               reach: bind the VPN interface, not every interface)
#   0.0.0.0     every interface, including the public one — only behind a firewall you trust
#
# ANYTHING OTHER THAN 127.0.0.1 MEANS OTHER MACHINES CAN REACH YOUR VAULT. Set an auth token
# first (docker/secrets/kovault_auth_token.txt) or you are publishing read AND write access to
# everything in it, plus a zip export of the whole vault, to anyone who can route to the port.
KOVAULT_BIND=127.0.0.1
